# Copy this file to .env and fill in what you need. .env stays on the server: the browser never sees it.

# Claude (Anthropic). Leave empty to run with the offline rules provider (nothing leaves the computer).
ANTHROPIC_API_KEY=

# auto = Claude when ANTHROPIC_API_KEY is set, otherwise offline rules.
# claude | local | offline force one provider.
AI_PROVIDER=auto
CLAUDE_MODEL=claude-sonnet-5-5

# Local / private model on Maru's own infrastructure (any OpenAI-compatible server: Ollama, vLLM, LM Studio).
# Used when AI_PROVIDER=local.
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen2.5:14b-instruct

# PDF rendering workers (0 = render inside the server process)
MARU_PDF_WORKERS=2

# Port for scripts/start.* and make run
PORT=8000
